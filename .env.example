# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Первый вход: учётная запись Super Admin создаётся при старте, если её ещё нет.
SUPERADMIN_NAME=admin
SUPERADMIN_PASSWORD=change-me

# Секрет подписи токенов входа: длинная случайная строка (например, `openssl rand -hex 32`).
# Без него токены сбрасываются при каждом перезапуске сервера.
JWT_SECRET=

# Адрес, от которого строятся ссылки-приглашения. С туннелем — его https-адрес из логов сервиса tunnel.
PUBLIC_URL=http://localhost:8000

# Регистрация игроков без приглашения (1 — открыта, 0 — только по ссылке-приглашению).
# OPEN_SIGNUP=1

# Журнал мастера (видят только Admin и Super Admin): 1 — со скрытыми бросками и шёпотом, 0 — только факт таких действий.
# MASTER_LOG_SECRETS=1

# Пароль базы в docker compose.
POSTGRES_PASSWORD=taleforge

# ==========================================
# Настройки Провайдеров ИИ
# ==========================================
# Активный провайдер для ИИ-мастера (gemini, claude, local)
LLM_PROVIDER=gemini

# --- Google Gemini ---
# GEMINI_API_KEY=
GEMINI_MAIN_MODEL=gemini-2.5-pro
GEMINI_TECHNICAL_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=
CLAUDE_MAIN_MODEL=anthropic/claude-opus-5
CLAUDE_TECHNICAL_MODEL=anthropic/claude-haiku-4-5

# --- Локальная нейросеть (LM Studio) ---
# LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1
LOCAL_MAIN_MODEL=qwen2.5-14b
LOCAL_TECHNICAL_MODEL=qwen2.5-7b
# Голосовые реплики: локальный сервер расшифровки (docker compose --profile voice up). Без адреса микрофона в чате нет.
# STT_API_BASE=http://stt:8000/v1
# Модель Whisper на сервере расшифровки; для процессора без видеокарты — Systran/faster-whisper-small.
# STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# STT_LANGUAGE=ru
# Сколько записей расшифровывать одновременно. Одна видеокарта — 1, остальные ждут в очереди.
# STT_CONCURRENCY=1

# Озвучка реплик мастера:
# Провайдер: gemini, silero, none (по умолчанию gemini)
# TTS_PROVIDER=gemini

# 1. Настройки для Gemini TTS:
# GEMINI_TTS_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Fenrir

# 2. Настройки для локального Silero TTS:
# SILERO_API_BASE=http://localhost:8001
# Голос по умолчанию. Мужские: aidar, eugene. Женские: xenia, kseniya, baya.
# SILERO_VOICE=aidar

# 3.XTTS v2:
# XTTS_API_BASE=http://localhost:8020
# XTTS_VOICE=default.wav



